sequenceDiagram
    actor App
    participant C as Correo
    participant E as Envio
    participant M as Movimiento

    App->>C: ultimoMovimiento(codigo)
    C->>C: buscarEnvio(codigo)
    alt envío inexistente
        C-->>App: NoSuchElementException
    end
    C->>E: obtenerUltimoMovimiento()
    alt sin movimientos
        E-->>App: NoSuchElementException
    end
    E-->>C: movimiento
    C-->>App: movimiento
    App->>M: toString()
    M-->>App: texto
    Note over App: App solo muestra el dato recibido
